# ==============================================================================
# CONFIGURAÇÕES DE AMBIENTE E SEGREDOS - CLOUDFLARE WORKER
# ==============================================================================
# ATENÇÃO: NUNCA COMITE O ARQUIVO COM DADOS REAIS (.env OU .dev.vars) NO GIT.
# Para registrar segredos no Cloudflare Workers em produção, use o CLI Wrangler:
#   npx wrangler secret put TELEGRAM_BOT_TOKEN
#   npx wrangler secret put TELEGRAM_CHAT_ID
#   npx wrangler secret put RESEND_API_KEY
# ==============================================================================

# 1. NOTIFICAÇÕES TELEGRAM BOT API
# Token fornecido pelo @BotFather no Telegram (ex: 123456789:ABCdefGHIjklMNOpqrsTUVwxyZ)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyZ"

# ID do chat ou canal para onde as notificações de novos leads serão enviadas (ex: 987654321 ou -100123456789)
TELEGRAM_CHAT_ID="987654321"

# 2. DISPARO DE E-MAILS RESEND
# Chave de API da Resend (obtenha em https://resend.com/api-keys)
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"

# Remetente dos e-mails de confirmação (Domínio verificado na Resend)
EMAIL_FROM="Rafael Franco <contato@francorafael.com>"

# 3. SEGURANÇA E CORS
# Origem permitida para envio de formulário (* para desenvolvimento ou 'https://francorafael.com')
ALLOWED_ORIGIN="*"
